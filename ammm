--// Refresh Friends List
local function RefreshFriendList()
    task.spawn(function()
        local success, result = pcall(function()
            return LocalPlayer:GetFriendsAsync()
        end)
        if not success or not result then
            Notify("Friends Error", "Could not fetch friend list", 2)
            return
        end

        FriendListCache = {}
        local count = 0
        for _, friendData in result do
            if friendData and friendData.Id then
                FriendListCache[friendData.Id] = true
                count = count + 1
            end
        end
        Notify("Friends Updated", "Loaded " .. count .. " friend(s)", 2)
    end)
end

--// Utility Functions
local function CancelLock()
    Environment.Locked = nil
    Environment.LockedPart = nil
    Environment.PredictedPosition = nil
    if FOVCircle then
        FOVCircle.Color = Environment.FOVSettings.Color
    end
end

local function IsVisible(part)
    if not part then return false end
    local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
    if not onScreen then return false end

    if Environment.Settings.WallCheck then
        local origin = Camera.CFrame.Position
        local direction = part.Position - origin
        local raycastParams = RaycastParams.new()
        raycastParams.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
        raycastParams.FilterType = Enum.RaycastFilterType.Exclude

        local result = workspace:Raycast(origin, direction, raycastParams)
        if result and not result.Instance:IsDescendantOf(part.Parent) then
            return false
        end
    end
    return true
end

--// Performance: throttle target acquisition to every 2 frames
local frameCounter = 0
local function GetClosestPlayer()
    frameCounter = frameCounter + 1
    if frameCounter % 2 ~= 0 and Running then
        -- Use previous target if still valid (reduces work)
        if Environment.Locked and Environment.LockedPart and Environment.LockedPart.Parent and Environment.Locked.Character then
            if IsVisible(Environment.LockedPart) then
                return
            end
        end
    end

    local closestTarget = nil
    local closestPart = nil
    local closestPredictedPos = nil
    local closestDistance = (Environment.FOVSettings.Enabled and Environment.FOVSettings.Amount or 2000)

    local targetBone = Environment.Settings.LockPart
    if targetBone == "Neck" then targetBone = "UpperTorso" end
    if targetBone == "Chest" then targetBone = "LowerTorso" end

    -- Local position for distance check (safe)
    local localPos = nil
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        localPos = char.HumanoidRootPart.Position
    end

    local maxRange = Environment.Settings.MaxDistance
    local useRange = (maxRange > 0) and (localPos ~= nil)
    local prediction = Environment.Settings.Prediction

    for _, v in next, Players:GetPlayers() do
        if v == LocalPlayer then continue end
        local character = v.Character
        if not character then continue end

        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid then continue end

        -- Team check with nil safety
        if Environment.Settings.TeamCheck then
            local myTeam = LocalPlayer.Team
            local theirTeam = v.Team
            if myTeam and theirTeam and myTeam == theirTeam then
                continue
            elseif not myTeam and not theirTeam then
                continue
            end
        end

        if Environment.Settings.AliveCheck and humanoid.Health <= 0 then continue end
        if Environment.Settings.IgnoreFriends and FriendListCache[v.UserId] then continue end

        local part = character:FindFirstChild(targetBone) or character:FindFirstChild("HumanoidRootPart")
        if part and IsVisible(part) then
            -- Calculate predicted position
            local predictedPos = part.Position
            if prediction > 0 and part.Velocity then
                predictedPos = part.Position + part.Velocity * prediction
            end

            if useRange then
                local distance = (predictedPos - localPos).Magnitude
                if distance > maxRange then
                    continue
                end
            end

            local screenPoint, onScreen = Camera:WorldToViewportPoint(predictedPos)
            if not onScreen then continue end

            local mouseLocation = UserInputService:GetMouseLocation()
            local distanceFromMouse = (Vector2(mouseLocation.X, mouseLocation.Y) - Vector2(screenPoint.X, screenPoint.Y)).Magnitude

            if distanceFromMouse < closestDistance then
                closestTarget = v
                closestPart = part
                closestPredictedPos = predictedPos
                closestDistance = distanceFromMouse
            end
        end
    end

    Environment.Locked = closestTarget
    Environment.LockedPart = closestPart
    Environment.PredictedPosition = closestPredictedPos
end

--// Main Execution Logic
local function Load()
    ServiceConnections.RenderSteppedConnection = RunService.RenderStepped:Connect(function()
        -- FOV circle update
        if FOVCircle and Environment.FOVSettings.Enabled and Environment.Settings.Enabled then
            FOVCircle.Radius = Environment.FOVSettings.Amount
            FOVCircle.Thickness = Environment.FOVSettings.Thickness
            FOVCircle.Filled = Environment.FOVSettings.Filled
            FOVCircle.NumSides = Environment.FOVSettings.Sides
            FOVCircle.Color = Environment.FOVSettings.Color
            FOVCircle.Transparency = Environment.FOVSettings.Transparency
            FOVCircle.Visible = Environment.FOVSettings.Visible
            FOVCircle.Position = UserInputService:GetMouseLocation()
        elseif FOVCircle then
            FOVCircle.Visible = false
        end

        if Running and Environment.Settings.Enabled then
            GetClosestPlayer()

            if Environment.Locked and Environment.LockedPart then
                -- Use predicted position if available, else current position
                local aimPosition = Environment.PredictedPosition or Environment.LockedPart.Position
                local screenPoint = Camera:WorldToViewportPoint(aimPosition)
                local mouseLocation = UserInputService:GetMouseLocation()

                if Environment.Settings.UseMouseMovement then
                    -- Improved mouse movement with deadzone
                    local deltaX = screenPoint.X - mouseLocation.X
                    local deltaY = screenPoint.Y - mouseLocation.Y

                    local factor = math.clamp(Environment.Settings.Sensitivity / 10, 0.05, 1)
                    local moveX = deltaX * factor
                    local moveY = deltaY * factor

                    -- Deadzone to eliminate micro-jitter
                    if math.abs(moveX) < 0.5 then moveX = 0 end
                    if math.abs(moveY) < 0.5 then moveY = 0 end

                    if mousemoverel then
                        mousemoverel(moveX, moveY)
                    end
                else
                    -- Camera lock (perfect accuracy)
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, aimPosition)
                end

                if FOVCircle then
                    FOVCircle.Color = Environment.FOVSettings.LockedColor
                end
            else
                CancelLock()
            end
        end
    end)

    ServiceConnections.TypingStarted = UserInputService.TextBoxFocused:Connect(function() Typing = true end)
    ServiceConnections.TypingEnded = UserInputService.TextBoxFocusReleased:Connect(function() Typing = false end)

    ServiceConnections.InputBegan = UserInputService.InputBegan:Connect(function(Input)
        if Typing then return end

        if Input.KeyCode.Name == Environment.Settings.MenuKey then
            MenuVisible = not MenuVisible
            if ScreenGui then ScreenGui.Enabled = MenuVisible end
        end

        local triggerKey = Environment.Settings.TriggerKey
        local isTrigger = (Input.UserInputType.Name == triggerKey or Input.KeyCode.Name == triggerKey)

        if isTrigger then
            if Environment.Settings.Toggle then
                Running = not Running
                if not Running then CancelLock() end
            else
                Running = true
            end
        end
    end)

    ServiceConnections.InputEnded = UserInputService.InputEnded:Connect(function(Input)
        if Typing or Environment.Settings.Toggle then return end

        local triggerKey = Environment.Settings.TriggerKey
        local isTrigger = (Input.UserInputType.Name == triggerKey or Input.KeyCode.Name == triggerKey)

        if isTrigger then
            Running = false
            CancelLock()
        end
    end)
end

